rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }
    function notBanned() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isBanned != true;
    }
    function onlyCounterChanged(counterField) {
      // Like/favourite toggles may only touch the counter field.
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([counterField]);
    }

    match /authors/{authorId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }
    match /quotes/{quoteId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create, delete: if isAdmin();
      // Counter-only updates from a like/favourite transaction.
      allow update: if isAdmin() ||
        (signedIn() && notBanned() && (
          onlyCounterChanged('likeCount') || onlyCounterChanged('favoriteCount')
        ));
    }
    match /topics/{topic} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /blogs/{blogId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create, update, delete: if isAdmin();
      allow update: if signedIn() && notBanned() && onlyCounterChanged('likeCount');
      match /comments/{commentId} {
        allow read: if resource.data.status == 'published' || isAdmin();
        allow create: if signedIn() && notBanned() &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.status == 'published';
        allow update, delete: if isAdmin() || isOwner(resource.data.userId);
      }
    }
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && request.resource.data.role == 'reader' &&
        request.resource.data.isBanned == false;
      allow update: if isOwner(uid) &&
        request.resource.data.diff(resource.data).changedKeys()
          .hasOnly(['displayName', 'photoURL', 'bio', 'preferences', 'lastLoginAt', 'stats']);
      allow update: if isAdmin();
    }
    match /likes/{likeId} {
      // Doc id must be "<uid>_<targetType>_<targetId>" and owned by the caller.
      allow read: if signedIn() && likeId.matches('^' + request.auth.uid + '_.*');
      allow create: if signedIn() && notBanned() &&
        likeId.matches('^' + request.auth.uid + '_.*') &&
        request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }
    match /favorites/{favId} {
      allow read: if signedIn() && favId.matches('^' + request.auth.uid + '_.*');
      allow create: if signedIn() && notBanned() &&
        favId.matches('^' + request.auth.uid + '_.*') &&
        request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }
    match /collections/{collectionId} {
      allow read: if resource.data.isPublic == true || isOwner(resource.data.userId) || isAdmin();
      allow create: if signedIn() && notBanned() &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }
    match /submissions/{submissionId} {
      allow create: if signedIn() && notBanned() &&
        request.resource.data.submittedBy == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow read: if isOwner(resource.data.submittedBy) || isAdmin();
      allow update, delete: if isAdmin();
    }
    match /newsletter_subscribers/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    match /counters/{name} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
