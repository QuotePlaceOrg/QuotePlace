rules_version = '2';

// StoicBare Storage rules.
//
// Public reads for blog cover images and author avatars.
// Authenticated users can write to their own folder.
// Admins can write anywhere.
//
// Deploy with: `firebase deploy --only storage`

service firebase.storage {
  match /b/{bucket}/o {
    // Public read for blog covers / author avatars / quote share images.
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() || isOwnerOfFolder();
    }

    // User-specific uploads (e.g. profile pics).
    match /users/{uid}/{allPaths=**} {
      allow read: if request.auth.uid == uid;
      allow write: if request.auth.uid == uid
                    && request.resource.size < 5 * 1024 * 1024  // 5MB max
                    && request.resource.contentType.matches('image/.*');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isOwnerOfFolder() {
      return isSignedIn() && request.auth.uid == uid;
    }
  }
}
